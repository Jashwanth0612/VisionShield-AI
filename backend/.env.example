# Never commit model weights. Mount them at runtime and point these variables at the mounted files.
NAFNET_WEIGHTS_PATH=/absolute/path/to/nafnet_weights.pth
RTDETR_WEIGHTS_PATH=/absolute/path/to/rtdetr_weights.pt

# Tune these only when they match the supplied NAFNet checkpoint.
NAFNET_WIDTH=32
NAFNET_MIDDLE_BLOCKS=1
NAFNET_ENCODER_BLOCKS=1,1,1,28
NAFNET_DECODER_BLOCKS=1,1,1,1

DETECTION_CONFIDENCE=0.35
MAX_UPLOAD_MB=20
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Replaceable local storage defaults. These can later point to another storage adapter.
ARTIFACT_DIR=data/artifacts
DATABASE_PATH=data/visionshield.db
